# Neon (Vercel Marketplace) pooled Postgres connection string — server only
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Vercel Blob store token (private store) — server only
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx

# Admin login — server only. Use a strong unique password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Random string, at least 32 characters (e.g. `openssl rand -hex 32`)
ADMIN_SESSION_SECRET=
